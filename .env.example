# Copy to .env and fill in values: cp .env.example .env

# Required — Anthropic
ANTHROPIC_API_KEY=

# SQLAlchemy async URL (default: local SQLite; swap for Supabase Postgres pooler URI)
DATABASE_URL=sqlite+aiosqlite:///./genie.db
# Example Supabase (transaction pooler): postgresql+asyncpg://postgres.PROJECT_REF:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase — URL + anon for Realtime / Auth in the browser; JWT secret for API token verification
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Project Settings → API → JWT Secret (HS256, audience "authenticated")
SUPABASE_JWT_SECRET=
# Set true to require Supabase login + onboarding before the SPA and to protect API routes (except /health, /api/config)
REQUIRE_AUTH=false
# OAuth buttons on login (comma-separated). Enable each provider in Dashboard → Authentication → Providers
SUPABASE_OAUTH_PROVIDERS=google,github
# Optional enterprise SSO: email domain configured for SAML/OIDC in Supabase (shows “Sign in with SSO”)
SUPABASE_SSO_DOMAIN=

# Model id passed to the Anthropic API
CLAUDE_MODEL=claude-sonnet-4-6
# Max output tokens per agent API call (lower = cheaper, shorter answers)
CLAUDE_MAX_TOKENS=2048
# Characters of each tool result injected into the next prompt (prevents huge listings from blowing context)
TOOL_RESULT_MAX_CHARS=10000

# Project manager: max Claude API round-trips per /orchestrate (see code docstring)
MAX_AGENT_ITERATIONS=4
# Each specialist (delegate_to_agent): max API round-trips
MAX_SPECIALIST_ITERATIONS=3
# Max specialist agents the PM may spawn in one orchestration (when the client does not override)
MAX_DELEGATE_CALLS=2
# API request caps (orchestrate body cannot exceed these)
ORCHESTRATE_MAX_ROUNDS_CAP=15
ORCHESTRATE_MAX_DELEGATE_CAP=8

# Python logging level (e.g. DEBUG, INFO, WARNING)
LOG_LEVEL=INFO

# Twilio — real SMS sending (leave blank to simulate)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15005550006

# Resend — real email sending (leave blank to simulate)
RESEND_API_KEY=
RESEND_FROM_EMAIL=genie@updates.yourdomain.com
